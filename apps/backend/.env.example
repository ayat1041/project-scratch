# =============================================================================
# STARTER BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8000
NODE_ENV=development
NETWORK_NAME=starter-dev-app-network
CONTAINER_NAME=starter-api-dev
EMAIL_CONSUMER_CONTAINER_NAME=starter-email-send-consumer-dev
DOMAIN=http://localhost:8000
COMMON_BASE=localhost
FRONTEND_URL=http://localhost:3000

# API key for internal/service-to-service requests (X-Api-Key header)
API_KEY=your-internal-api-key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-database-name

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
RABBITMQ_URL=amqp://starter:starterRabbit123@starter-rabbitmq-dev:5672

# =============================================================================
# JWT & AUTHENTICATION CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
# CSRF_SECRET must be a DIFFERENT value from JWT_SECRET (defense-in-depth)
CSRF_SECRET=your-dedicated-csrf-secret-different-from-jwt-secret
ACCESS_TOKEN_AGE="15 mins from now"
ACCESS_TOKEN_COOKIE_MAX_AGE=900000
REFRESH_TOKEN_AGE="30 days from now"
REFRESH_TOKEN_COOKIE_MAX_AGE=2592000000
ACCESS_TOKEN_NAME="access_token"
REFRESH_TOKEN_NAME="refresh_token"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_HOST=smtp.mailtrap.io
RESEND_USER=your-mailtrap-user
RESEND_PASSWORD=your-mailtrap-password
EMAIL_USER=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# LINKEDIN OAUTH CONFIGURATION (Optional)
# =============================================================================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=

# Discord webhook for error/alert notifications — required in production/staging
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Host IPs surfaced in logs/traces for correlation with infra dashboards
MONITORING_HOST_IP=
PRIVATE_IP=

# =============================================================================
# RATE LIMITING CONFIGURATION (Optional)
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
