{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "DATABASE_URL=postgresql://starteruser:StarterProdDB123@localhost:5432/starterdb REDIS_HOST=localhost find src -name '*.test.ts' ! -path '*/__integration__/*' | xargs tsx --test --test-force-exit --test-concurrency=4",
    "test:integration": "jest --config jest.config.ts",
    "test:services": "find src -type f -name '*.service.test.ts' | xargs tsx --test --test-force-exit --test-concurrency=4",
    "test:file": "bash -lc 'FILE=\"$1\"; if [ \"$FILE\" = \"--\" ]; then FILE=\"$2\"; fi; if [ -z \"$FILE\" ]; then echo \"Usage: pnpm run test:file -- <file.test.ts>\"; exit 1; fi; START=\"${INIT_CWD:-$PWD}\"; MATCH=$(find \"$START\" src -type f -name \"$FILE\" 2>/dev/null | head -n 1); if [ -z \"$MATCH\" ]; then echo \"Test file not found: $FILE\"; exit 1; fi; echo \"Running: $MATCH\"; tsx --test \"$MATCH\"' --",
    "start": "node --max-old-space-size=4096 dist/server.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' tsx watch --clear-screen=false src/server.ts",
    "dev:nodemon": "NODE_OPTIONS='--max-old-space-size=4096' nodemon --ignore paraphrasedData/ --ignore storage/ --ignore data-objects/ src/server.ts",
    "dev:swc": "NODE_OPTIONS='--max-old-space-size=4096' nodemon --exec 'node --loader @swc-node/register/esm' src/server.ts",
    "build": "tsc && tsc-alias",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check:spec-drift": "tsx scripts/check-spec-drift.ts",
    "check:spec-stale": "tsx scripts/check-spec-stale.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky",
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" src/db/schema/seed.ts",
    "email-send-consumer:dev": "NODE_OPTIONS='--max-old-space-size=4096' tsx watch --clear-screen=false src/workers/email-send-consumer.ts",
    "email-send-consumer": "node --max-old-space-size=4096 dist/workers/email-send-consumer.js"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.201.1",
    "@opentelemetry/sdk-node": "^0.201.1",
    "@repo/constants": "workspace:*",
    "@repo/schemas-types": "workspace:*",
    "@repo/utilities": "workspace:*",
    "@types/pg": "^8.11.10",
    "@types/ua-parser-js": "^0.7.39",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "arctic": "^3.2.1",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "express": "^5.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "^5.9.6",
    "module-alias": "^2.2.3",
    "node-cron": "^4.2.0",
    "nodemailer": "^6.9.16",
    "nodemon": "^3.1.9",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "response-time": "^2.3.3",
    "sanitize-html": "^2.17.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.2",
    "ua-parser-js": "^2.0.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@types/amqplib": "^0.10.8",
    "@types/axios": "^0.14.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/response-time": "^2.3.8",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.11",
    "typescript": "5.9.2"
  },
  "_moduleAliases": {
    "@": "./src"
  }
}
