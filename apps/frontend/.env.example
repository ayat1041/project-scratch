API_URL=
NEXT_PUBLIC_API_URL=
UPLOAD_FILE_API_URL=
NEXT_PUBLIC_UPLOAD_FILE_API_URL=

# =============================================================================
# OAUTH SIGN-IN (Google / LinkedIn)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
# Public CDN domain files are served from after upload (e.g. https://cdn.example.com)
NEXT_PUBLIC_CDN_URL=

# Grafana Faro Observability
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_APP_NAME=starter-frontend
NEXT_PUBLIC_FARO_APP_NAMESPACE=
NEXT_PUBLIC_FARO_APP_VERSION=1.0.0
NEXT_PUBLIC_FARO_ENVIRONMENT=development

# Source Map Upload (Get from Grafana Cloud → Configuration)
FARO_SOURCE_MAP_API_KEY=
NEXT_PUBLIC_FARO_APP_ID=
FARO_STACK_ID=


NETWORK_NAME=
PORT=
CONTAINER_NAME=

# OpenTelemetry (Server-Side Tracing)
# Optional: Configure if you want to send traces to a custom endpoint
# By default, @vercel/otel sends traces to Vercel's infrastructure
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector-endpoint
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=your-api-key
# OTEL_SERVICE_NAME=starter-frontend
