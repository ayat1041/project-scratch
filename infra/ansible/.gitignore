# Ansible runtime artifacts
*.retry
.ansible/
ansible.log
/tmp/ansible_facts/

# Vault files — unencrypted copies must never be committed.
# After running `ansible-vault encrypt app_vault.yml` the encrypted file IS safe to commit.
# Track encrypted vault files explicitly: git add -f inventory/host_vars/app_vault.yml
*_vault.yml
*.vault
*.secret
.vault_pass

